{
  "description": "Load the behavioral floor at SessionStart. Repo-local wiring remains active before plugin provisioning; shared invocation claims deduplicate it from the installed plugin.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/session_floor.py\"",
            "commandWindows": "python -B \".agents/hooks/session_floor.py\"",
            "timeout": 15,
            "statusMessage": "Loading the always-on behavioral floor"
          }
        ]
      }
    ]
  }
}
