<Project>


  <!-- Shared test-tier gate. Imported explicitly because MSBuild auto-imports only the FIRST
       Directory.Build.targets found walking up, so this file shadows api/Directory.Build.targets
       for everything beneath it. Relative path, matching how api/BannedSymbols.txt is shared. -->
  <Import Project="$(MSBuildThisFileDirectory)TestConventions.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)TestConventions.targets')" />

</Project>
